# Copy this file to .env for local development (never commit the real .env).
# On Render, set these under the service's "Environment" tab instead.

GROQ_API_KEY=your_new_groq_key_here
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
SECRET_KEY=any_random_string_for_flask_sessions
FLASK_DEBUG=false
