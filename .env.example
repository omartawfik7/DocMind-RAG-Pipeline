# Copy this file to .env for local development (never commit the real .env).
# On Render, set these under the service's "Environment" tab instead.

GROQ_API_KEY=your_new_groq_key_here
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
SECRET_KEY=any_random_string_for_flask_sessions
FLASK_DEBUG=false

# -- LLM provider selection (optional) --------------------------------
# "groq" (default -- unchanged behavior), "anthropic", or "openai".
# Only the selected provider's API key is required.
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -- Agent / security governance thresholds (optional -- all have safe
#    defaults; see config.py) ------------------------------------------
# MAX_SUPERVISOR_STEPS=6
# MAX_TOOL_CALLS=4
# MAX_SUBQUERIES=3
# TOOL_TIMEOUT_SECONDS=15
# ANOMALY_SCORE_KILL_THRESHOLD=3
# KILL_SWITCH_MAX_DURATION_SECONDS=60
# AUDIT_LOG_PATH=./logs/audit.jsonl
